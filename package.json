{
  "name": "flock-event-studio",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "dev": "pnpm --filter @flock/templates build && pnpm --parallel --filter @flock/templates --filter @flock/web dev",
    "build": "pnpm --filter @flock/templates build && pnpm --filter @flock/web build",
    "db:up": "docker --context orbstack compose up -d --wait",
    "db:down": "docker --context orbstack compose down",
    "db:generate": "pnpm --filter @flock/db generate",
    "db:migrate": "pnpm --filter @flock/db migrate",
    "db:seed": "pnpm --filter @flock/db seed",
    "db:studio": "pnpm --filter @flock/db studio",
    "bootstrap": "pnpm db:up && pnpm db:migrate && pnpm db:seed && pnpm --filter @flock/templates build",
    "render:event": "pnpm --filter @flock/templates build && tsx tools/render-event.ts",
    "diversity": "pnpm --filter @flock/templates build && tsx --env-file-if-exists=.env tools/diversity-sheet.ts",
    "evals": "pnpm --filter @flock/templates build && tsx --env-file-if-exists=.env tools/evals/run.ts",
    "prompts:lock": "tsx tools/prompts-lock.ts",
    "test": "pnpm --filter @flock/templates build && vitest run",
    "design:templates": "pnpm --filter @flock/templates build && tsx --env-file-if-exists=.env tools/design-templates.ts"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "vitest": "3.2.4"
  }
}
