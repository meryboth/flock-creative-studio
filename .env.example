# Postgres local (OrbStack, ver docker-compose.yml)
DATABASE_URL=postgres://flock:flock@localhost:5433/flock_event_studio

# LLM / imagen (fases 2+)
GOOGLE_API_KEY=
# Se prueban en orden; si uno falla (503, 404) se usa el siguiente
GEMINI_MODELS=gemini-3.5-flash,gemini-3.8-flash,gemini-flash-latest
GEMINI_VISION_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite,gemini-flash-latest
# Generación de imágenes: requiere facturación activa en el proyecto de Google Cloud
GEMINI_IMAGE_MODELS=gemini-3.1-flash-image,gemini-2.5-flash-image

# Generación de key visuals: proveedores en orden (gemini = API, ~12 s y usa la referencia; comfyui = local y gratis, ~2,5 min)
KEYVISUAL_PROVIDERS=gemini,comfyui
COMFYUI_URL=http://127.0.0.1:8000
COMFYUI_CHECKPOINT=sd_xl_base_1.0.safetensors

# Publicaciones programadas (opcional: sin estas variables se programa igual y se publica al conectar)
# Slack: app interna con bot token (scopes files:write, chat:write), invitada al canal
SLACK_BOT_TOKEN=
SLACK_DEFAULT_CHANNEL=
# Canales sugeridos al programar, y programar en Slack mismo (ver docs/integraciones/slack.md)
SLACK_CHANNELS=
SLACK_NATIVE_SCHEDULE=
# LinkedIn: token OAuth con w_organization_social (página) o w_member_social (perfil)
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
LINKEDIN_VERSION=202509

# Claude (Anthropic)
ANTHROPIC_API_KEY=

# Proveedores de LLM para textos, editor y visión, en orden (claude = Anthropic, gemini = Google)
LLM_PROVIDERS=claude,gemini
CLAUDE_MODELS=claude-sonnet-5-5,claude-haiku-5-5
CLAUDE_VISION_MODELS=claude-sonnet-5-5,claude-haiku-5-5

# Crítico de fidelidad al leer una referencia (rondas; 0 lo apaga). Cada ronda suma ~5 s.
CRITIC_ROUNDS=1

# Métricas (ver docs/metricas-y-evals.md)
# Precios de los modelos para estimar costos (JSON, pisa la tabla de packages/agents/src/pricing.ts)
MODEL_PRICES=
# Línea base del trabajo manual en minutos por pieza (JSON, pisa packages/studio/src/baseline.ts)
BASELINE_MINUTES=
# Nombre de la instalación en la telemetría (sin login todavía)
FLOCK_ACTOR=local
# Rondas de revisión al diseñar plantillas con IA (cada ronda: diseñador + controles + revisor)
DESIGN_ROUNDS=2
