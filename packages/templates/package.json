{
  "name": "@flock/templates",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "default": "./dist/jsx-runtime.js"
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "dev": "tsc -p . --watch --preserveWatchOutput",
    "typecheck": "tsc -p . --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/pixelify-sans": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/gloock": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "culori": "^4.0.2"
  },
  "devDependencies": {
    "@types/culori": "^4.0.1",
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3"
  }
}
